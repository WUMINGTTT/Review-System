// prisma/schema.prisma
//
// 评价系统数据库模型定义
// 对应 packages/shared/src/ 中的 TypeScript 类型
// 数据库: MySQL
// 表名/字段名: snake_case（通过 @map 映射为 camelCase）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 枚举 ====================

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  REJECTED
  APPROVED
  ARCHIVED
}

enum RatingItemStatus {
  PENDING
  DRAFT
  SUBMITTED
}

enum NotificationType {
  EVALUATION_SUBMITTED
  EVALUATION_APPROVED
  EVALUATION_REJECTED
  EVALUATION_ARCHIVED
  ASSIGNED_AS_REVIEWER
  DEADLINE_REMINDER
}

// ==================== 用户 ====================

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  password   String
  realName   String    @map("real_name")
  department String?
  email      String?
  phone      String?
  avatar     String?
  roles      String    @default("[]") // JSON 字符串，如 '["user"]' 或 '["admin"]'
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // 关联
  createdEvaluations Evaluation[]       @relation("Creator")
  reviewerRecords    EvaluationReviewer[]
  ratingItems        RatingItem[]
  notifications      Notification[]

  @@map("users")
}

// ==================== 评价活动 ====================

model Evaluation {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  department  String?
  status      EvaluationStatus @default(DRAFT)
  deadline    DateTime?
  createdBy   Int              @map("created_by")
  rejectReason String?         @map("reject_reason")
  reviewComment String?        @map("review_comment")
  submittedAt DateTime?        @map("submitted_at")
  reviewedAt  DateTime?        @map("reviewed_at")
  archivedAt  DateTime?        @map("archived_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // 关联
  creator        User                  @relation("Creator", fields: [createdBy], references: [id])
  reviewers      EvaluationReviewer[]
  participants   Participant[]
  scoreDimensions ScoreDimension[]
  ratingItems    RatingItem[]

  @@index([createdBy])
  @@index([status])
  @@map("evaluations")
}

// 评价-评审人 多对多关联表
// 一个评价可以有多个评审人，一个用户可以在多个评价中担任评审人
model EvaluationReviewer {
  id           Int        @id @default(autoincrement())
  evaluationId Int        @map("evaluation_id")
  reviewerId   Int        @map("reviewer_id")

  // 关联
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  reviewer     User       @relation(fields: [reviewerId], references: [id])

  @@unique([evaluationId, reviewerId])
  @@index([reviewerId])
  @@map("evaluation_reviewers")
}

// ==================== 被评价人 ====================

model Participant {
  id           Int        @id @default(autoincrement())
  evaluationId Int        @map("evaluation_id")
  name         String
  department   String
  position     String?
  phone        String?

  // 关联
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  ratingItems  RatingItem[]

  @@index([evaluationId])
  @@map("participants")
}

// ==================== 评分维度 ====================

model ScoreDimension {
  id           Int      @id @default(autoincrement())
  evaluationId Int      @map("evaluation_id")
  name         String
  description  String
  maxScore     Int      @default(100) @map("max_score")
  weight       Float

  // 关联
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, name])
  @@index([evaluationId])
  @@map("score_dimensions")
}

// ==================== 评分记录 ====================

model RatingItem {
  id             Int              @id @default(autoincrement())
  evaluationId   Int              @map("evaluation_id")
  participantId  Int              @map("participant_id")
  reviewerId     Int              @map("reviewer_id")
  status         RatingItemStatus @default(PENDING)
  comment        String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // 关联
  evaluation     Evaluation       @relation(fields: [evaluationId], references: [id])
  participant    Participant      @relation(fields: [participantId], references: [id])
  reviewer       User             @relation(fields: [reviewerId], references: [id])
  dimensionScores DimensionScore[]

  @@unique([evaluationId, participantId, reviewerId])
  @@index([reviewerId, status])
  @@map("rating_items")
}

// ==================== 维度评分 ====================

model DimensionScore {
  id            Int    @id @default(autoincrement())
  ratingItemId  Int    @map("rating_item_id")
  dimensionId   Int    @map("dimension_id")
  dimensionName String @map("dimension_name")
  score         Float
  maxScore      Int    @map("max_score")
  weight        Float

  // 关联
  ratingItem    RatingItem @relation(fields: [ratingItemId], references: [id], onDelete: Cascade)

  @@index([ratingItemId])
  @@map("dimension_scores")
}

// ==================== 通知 ====================

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String
  content   String
  relatedId Int?             @map("related_id")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // 关联
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}
